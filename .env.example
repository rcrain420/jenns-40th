# Local Postgres (Docker: npm run db:up)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/jenns40th"
# Same as DATABASE_URL locally; on Neon/Vercel use the unpooled/direct connection string
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5433/jenns40th"

# Production (Neon) — pooled + unpooled URLs are injected by the Vercel Neon integration
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

ADMIN_PASSWORD="changeme"
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
EVENT_PIN="replace-with-shared-event-pin"

# Optional: override default Venmo deep link (see src/lib/config.ts)
VENMO_URL=""

# Optional: OpenAI for catch estimates + team-name suggestions
OPENAI_API_KEY=""
# OPENAI_VISION_MODEL="gpt-4o-mini"
# OPENAI_TEAM_NAME_MODEL="gpt-4o-mini"

# Optional locally / auto on Vercel when a Blob store is linked
# Without this token, catch photos write to public/uploads/catches (local only)
BLOB_READ_WRITE_TOKEN=""

# Optional: canonical site URL for metadata and magic links (falls back to VERCEL_URL)
# NEXT_PUBLIC_APP_URL="https://officialishfishingtournament.com"

# Optional: Resend delivers registration confirmation + unlock emails
# RESEND_API_KEY=""
# RESEND_FROM="Official-ish Tournament <noreply@officialishfishingtournament.com>"
