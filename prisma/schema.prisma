generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled URL for queries; unpooled for migrations (set on Vercel)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  /// Google (or other OAuth) profile photo URL. Null for email-only accounts.
  imageUrl        String?
  /// Null/empty for Google or Facebook-only accounts until they set a password.
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// GUEST | ADMIN
  role            String    @default("GUEST")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tokens          EmailToken[]
  oauthAccounts   OAuthAccount[]
  claimedTeams    Team[]
  memberships     TeamMember[]
  catches         FishCatch[]
  comments        CatchComment[]
  paymentsCreated Payment[]
  weighedFishEntered WeighedFish[] @relation("WeighedFishEnteredBy")
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// google | facebook
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CONFIRM_EMAIL | RESET_PASSWORD
  type      String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([tokenHash])
}

model Team {
  id               String   @id @default(cuid())
  teamName         String
  /// BOAT | YOUTH_LAND — land-only RowRide entries are not a paid boat.
  entryKind        String   @default("BOAT")
  /// GUIDED | NON_GUIDED. Unused for YOUTH_LAND (stored as NON_GUIDED).
  boatType         String
  captainName      String?
  captainPhone     String?
  /// Optional. Invites the captain to sign in. Not an Angler seat.
  captainEmail     String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  registrantEmail  String
  notes            String?
  licenseConfirmed Boolean
  /// UNPAID | PARTIAL | PAID — derived from amountPaidCents vs amountDueCents
  paymentStatus    String   @default("UNPAID")
  /// Paid side pot ids: trout | blackjack | spots
  sidePots         String[] @default([])
  amountDueCents   Int
  /// Denormalized sum of Payment.amountCents; kept in sync on ledger writes.
  amountPaidCents  Int      @default(0)
  claimedByUserId  String?
  claimedByUser    User?    @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  anglers          Angler[]
  members          TeamMember[]
  inviteCodes      TeamInviteCode[]
  payments         Payment[]
  weighedFish      WeighedFish[]
  mainStringers    MainStringer[]
  sidePotEntries   SidePotEntry[]

  @@index([captainEmail])
  @@index([claimedByUserId])
}

/// Per-boat payment ledger. Writes are MANUAL today; VENMO is reserved for later.
model Payment {
  id              String   @id @default(cuid())
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  amountCents     Int
  note            String?
  /// MANUAL | VENMO
  source          String   @default("MANUAL")
  createdAt       DateTime @default(now())
  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([createdByUserId])
}

/// Unguessable share code for /j/<code>. Long JWTs stay valid on /join?token=.
model TeamInviteCode {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teamId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model Angler {
  id        String         @id @default(cuid())
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  /// Optional. Name-only seats stay on the PIN / shared-link path.
  email     String?
  /// 17 or under. RowRide youth — does not consume a 1–4 adult boat seat.
  isYouth   Boolean        @default(false)
  /// XS–3XL merch size. Required on register / roster save for named anglers.
  shirtSize String?
  sortOrder Int
  catches   FishCatch[]
  comments  CatchComment[]

  @@index([teamId])
}

model FishCatch {
  id           String         @id @default(cuid())
  anglerId     String?
  angler       Angler?        @relation(fields: [anglerId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoPath    String
  breed        String
  /// Null when AI did not run (fallback) — do not invent placeholder inches.
  lengthInches Float?
  /// Null when AI did not run (fallback) — do not invent placeholder pounds.
  weightLbs    Float?
  confidence   Float?
  aiNotes      String?
  aiProvider   String
  createdAt    DateTime       @default(now())
  comments     CatchComment[]

  @@index([anglerId])
  @@index([userId])
  @@index([createdAt])
}

model CatchComment {
  id        String    @id @default(cuid())
  catchId   String
  catch     FishCatch @relation(fields: [catchId], references: [id], onDelete: Cascade)
  anglerId  String?
  angler    Angler?   @relation(fields: [anglerId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime  @default(now())

  @@index([catchId])
  @@index([anglerId])
  @@index([userId])
  @@index([createdAt])
}

/// One scale event (tournament Saturday, or a practice reopen).
model WeighSession {
  id        String   @id @default(cuid())
  /// e.g. "2026-10-10 main"
  label     String
  startsAt  DateTime?
  endsAt    DateTime?
  /// OPEN | CLOSED
  status    String   @default("CLOSED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fish      WeighedFish[]
  stringers MainStringer[]
  sidePots  SidePotEntry[]

  @@index([status])
}

/// Official scale ticket. Not a Livewell photo and not an AI estimate.
model WeighedFish {
  id              String       @id @default(cuid())
  sessionId       String
  session         WeighSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// TROUT | REDFISH | CATFISH
  species         String
  weightLbs       Float
  lengthInches    Float?
  spotCount       Int?
  weighedAt       DateTime
  /// Monotonic per session. Tie-break when timestamps match.
  sequence        Int
  disqualified    Boolean      @default(false)
  dqReason        String?
  /// Spotted Seatrout Tag or Bonus Spotted Seatrout Tag. Ineligible for stringer and trout pot.
  taggedTrout     Boolean      @default(false)
  notes           String?
  enteredByUserId String?
  enteredByUser   User?        @relation("WeighedFishEnteredBy", fields: [enteredByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  troutSlot       MainStringer?     @relation("MainStringerTrout")
  redfishSlots    MainStringerFish[]
  sidePotEntries  SidePotEntry[]

  @@unique([sessionId, sequence])
  @@index([sessionId, weighedAt])
  @@index([teamId])
  @@index([species])
  @@index([enteredByUserId])
}

/// One official main stringer per boat per session.
model MainStringer {
  id             String            @id @default(cuid())
  sessionId      String
  session        WeighSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// DRAFT | LOCKED | DQ
  status         String            @default("DRAFT")
  troutFishId    String?           @unique
  troutFish      WeighedFish?      @relation("MainStringerTrout", fields: [troutFishId], references: [id], onDelete: SetNull)
  totalWeightLbs Float             @default(0)
  lockedAt       DateTime?
  unlockNote     String?
  dqReason       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  redfish        MainStringerFish[]

  @@unique([sessionId, teamId])
  @@index([sessionId, status])
  @@index([teamId])
}

/// Redfish slots 1–3 on a main stringer.
model MainStringerFish {
  id            String      @id @default(cuid())
  stringerId    String
  stringer      MainStringer @relation(fields: [stringerId], references: [id], onDelete: Cascade)
  weighedFishId String      @unique
  weighedFish   WeighedFish @relation(fields: [weighedFishId], references: [id], onDelete: Cascade)
  /// 1 | 2 | 3
  slot          Int

  @@unique([stringerId, slot])
  @@index([stringerId])
}

/// One competing fish per team per paid side pot (trout | blackjack | spots).
model SidePotEntry {
  id               String       @id @default(cuid())
  sessionId        String
  session          WeighSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// trout | blackjack | spots
  potId            String
  teamId           String
  team             Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  weighedFishId    String
  weighedFish      WeighedFish  @relation(fields: [weighedFishId], references: [id], onDelete: Cascade)
  /// Sort key: trout weight, blackjack length, spots count.
  metricValue      Float
  metricLabel      String
  eligible         Boolean
  ineligibleReason String?
  weighedAt        DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([sessionId, potId, teamId])
  @@index([sessionId, potId, eligible])
  @@index([teamId])
  @@index([weighedFishId])
}
