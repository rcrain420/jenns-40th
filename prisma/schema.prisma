generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled URL for queries; unpooled for migrations (set on Vercel)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  /// Google (or other OAuth) profile photo URL. Null for email-only accounts.
  imageUrl        String?
  /// Null/empty for Google or Facebook-only accounts until they set a password.
  passwordHash    String?
  emailVerifiedAt DateTime?
  /// GUEST | ADMIN
  role            String    @default("GUEST")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tokens          EmailToken[]
  oauthAccounts   OAuthAccount[]
  claimedTeam     Team?
  membership      TeamMember?
  catches         FishCatch[]
  comments        CatchComment[]
}

model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// google | facebook
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CONFIRM_EMAIL | RESET_PASSWORD
  type      String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([tokenHash])
}

model Team {
  id               String   @id @default(cuid())
  teamName         String
  /// GUIDED | NON_GUIDED
  boatType         String
  captainName      String?
  captainPhone     String?
  /// Optional. Invites the captain to sign in. Not an Angler seat.
  captainEmail     String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  registrantEmail  String
  notes            String?
  licenseConfirmed Boolean
  /// UNPAID | PAID
  paymentStatus    String   @default("UNPAID")
  /// Paid side pot ids: trout | blackjack | spots
  sidePots         String[] @default([])
  amountDueCents   Int
  claimedByUserId  String?  @unique
  claimedByUser    User?    @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  anglers          Angler[]
  members          TeamMember[]
  inviteCodes      TeamInviteCode[]

  @@index([captainEmail])
}

/// Unguessable share code for /j/<code>. Long JWTs stay valid on /join?token=.
model TeamInviteCode {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  code      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teamId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([teamId])
}

model Angler {
  id        String         @id @default(cuid())
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  /// Optional. Name-only seats stay on the PIN / shared-link path.
  email     String?
  /// 17 or under. Roster seat for the kids pot; no $75 entry. No child User account.
  isYouth   Boolean        @default(false)
  /// XS–3XL merch size. Required on register / roster save for named anglers.
  shirtSize String?
  sortOrder Int
  catches   FishCatch[]
  comments  CatchComment[]

  @@index([teamId])
}

model FishCatch {
  id           String         @id @default(cuid())
  anglerId     String?
  angler       Angler?        @relation(fields: [anglerId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoPath    String
  breed        String
  /// Null when AI did not run (fallback) — do not invent placeholder inches.
  lengthInches Float?
  /// Null when AI did not run (fallback) — do not invent placeholder pounds.
  weightLbs    Float?
  confidence   Float?
  aiNotes      String?
  aiProvider   String
  createdAt    DateTime       @default(now())
  comments     CatchComment[]

  @@index([anglerId])
  @@index([userId])
  @@index([createdAt])
}

model CatchComment {
  id        String    @id @default(cuid())
  catchId   String
  catch     FishCatch @relation(fields: [catchId], references: [id], onDelete: Cascade)
  anglerId  String?
  angler    Angler?   @relation(fields: [anglerId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime  @default(now())

  @@index([catchId])
  @@index([anglerId])
  @@index([userId])
  @@index([createdAt])
}
