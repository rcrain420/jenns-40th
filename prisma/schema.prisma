generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled URL for queries; unpooled for migrations (set on Vercel)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  /// GUEST | ADMIN
  role            String    @default("GUEST")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tokens          EmailToken[]
  claimedTeam     Team?
  membership      TeamMember?
  catches         FishCatch[]
  comments        CatchComment[]
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CONFIRM_EMAIL | RESET_PASSWORD
  type      String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([tokenHash])
}

model Team {
  id               String   @id @default(cuid())
  teamName         String
  /// GUIDED | NON_GUIDED
  boatType         String
  captainName      String?
  captainPhone     String?
  contactName      String?
  contactPhone     String?
  contactEmail     String?
  registrantEmail  String
  notes            String?
  licenseConfirmed Boolean
  /// UNPAID | PAID
  paymentStatus    String   @default("UNPAID")
  /// Paid side pot ids: trout | blackjack | spots
  sidePots         String[] @default([])
  amountDueCents   Int
  claimedByUserId  String?  @unique
  claimedByUser    User?    @relation(fields: [claimedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  anglers          Angler[]
  members          TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([teamId])
}

model Angler {
  id        String         @id @default(cuid())
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  sortOrder Int
  catches   FishCatch[]
  comments  CatchComment[]

  @@index([teamId])
}

model FishCatch {
  id           String         @id @default(cuid())
  anglerId     String?
  angler       Angler?        @relation(fields: [anglerId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  photoPath    String
  breed        String
  lengthInches Float
  weightLbs    Float
  confidence   Float?
  aiNotes      String?
  aiProvider   String
  createdAt    DateTime       @default(now())
  comments     CatchComment[]

  @@index([anglerId])
  @@index([userId])
  @@index([createdAt])
}

model CatchComment {
  id        String    @id @default(cuid())
  catchId   String
  catch     FishCatch @relation(fields: [catchId], references: [id], onDelete: Cascade)
  anglerId  String?
  angler    Angler?   @relation(fields: [anglerId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime  @default(now())

  @@index([catchId])
  @@index([anglerId])
  @@index([userId])
  @@index([createdAt])
}
